{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/api/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/(vit-online-mba|MBA)(\\.php)?$",
      "dest": "/api/MBA.php"
    },
    {
      "src": "/(vit-online-mca|MCA)(\\.php)?$",
      "dest": "/api/MCA.php"
    },
    {
      "src": "/(vit-online-mcds|vit-online-msds|MsDS)(\\.php)?$",
      "dest": "/api/MsDS.php"
    },
    {
      "src": "/(vit|index)(\\.php)?$",
      "dest": "/api/index.php"
    },
    {
      "src": "/$",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
