{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/api/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/(MBA|MCA|MsDS|index)\\.php",
      "dest": "/api/$1.php"
    },
    {
      "src": "/(MBA|MCA|MsDS)",
      "dest": "/api/$1.php"
    },
    {
      "src": "/$",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
